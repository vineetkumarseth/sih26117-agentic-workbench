# Copy this file to .env and adjust. Never commit the real .env — it's
# already in .gitignore.

ENVIRONMENT=development

# --- Auth ---------------------------------------------------------------
# Leave SECRET_KEY unset in dev and the app will generate a throwaway one
# at boot (a new one every restart, which invalidates old tokens — fine
# for a hackathon demo). Set an explicit, long random value for anything
# that needs to survive a restart or run in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_USERNAME=admin
# Leave blank to auto-generate a random admin password at first boot —
# it's printed once to the server log. Set it explicitly if you'd rather
# choose it yourself.
ADMIN_PASSWORD=

# --- CORS -----------------------------------------------------------
# Comma-separated list of origins allowed to call this API. Add your
# deployed frontend's URL here — never use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads --------------------------------------------------------
MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/uploads

# --- Database -------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/workbench.db

# --- Vector store (Qdrant) ------------------------------------------
# Leave QDRANT_URL blank to run Qdrant embedded (on-disk, no server).
# Set it (e.g. http://localhost:6333) to use the Qdrant container from
# docker-compose.yml instead.
QDRANT_URL=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=industrial_documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:latest

# Keep MOCK_LLM=true until you've run:
#   ollama pull llama3.1:8b
#   ollama pull llava
# then flip this to false for real, grounded answers.
MOCK_LLM=true

# --- Guardrails -------------------------------------------------------
# The lightweight rules layer in app/guardrails/guard.py is always on.
# Set this to true to additionally route through the full NeMo
# Guardrails engine (app/guardrails/config.yml) — see that file's
# comments for the extra setup it needs.
USE_NEMO_GUARDRAILS=false

# --- Optional: Langfuse observability export --------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
